# Stoic ELN — environment variables
#
# Copy this file to `.env` (in the same directory as
# docker-compose.yml) and edit the values. The .env file is
# loaded automatically by `docker compose up`.
#
# .env contains secrets. Never commit it. The .gitignore is
# already set up to exclude it.

# ─── REQUIRED ──────────────────────────────────────────────────

# Flask secret key for signing session cookies and CSRF tokens.
# Generate one and never share it. Changing it logs out all users.
#
# Generate with:    openssl rand -hex 32
SECRET_KEY=

# Domain Caddy will serve Stoic on.
#
#   stoic.local       LAN install with self-signed HTTPS (default)
#   lab.example.com   Public install with automatic Let's Encrypt
#   localhost         Development / CI, HTTP only on :80
#
# For a *.local domain, you'll need either mDNS (works on macOS,
# iOS, and Linux with avahi-daemon) or a host file entry on each
# client device.
STOIC_DOMAIN=stoic.local

# ─── OPTIONAL ──────────────────────────────────────────────────

# Caddy's ACME contact address is NOT set here. It used to be, and
# leaving it blank — the default — made Caddy refuse to start. The
# address is optional for Let's Encrypt and ignored for *.local, so
# the directive is simply absent from the Caddyfile. If you run a
# public domain and want expiry notices, add `email you@example.com`
# to the Caddyfile's global block by hand.

# Number of gunicorn workers. Rule of thumb: (2 * CPU_CORES) + 1.
# Two workers are fine on a Raspberry Pi 3B with 1 GB of RAM
# (measured: ~230 MiB resident, 460 MB still free).
# Default (when unset) is 2.
STOIC_WORKERS=2

# Per-request timeout in seconds. PDF generation on slow hardware
# can exceed the default 30s; 120s is safe everywhere.
STOIC_TIMEOUT=120

# Override the Docker image tag. Useful for pinning a specific
# version (`v1.0.0`) in production or for using a local dev build.
# When unset, docker-compose pulls `:latest`.
# STOIC_IMAGE=ghcr.io/the-stoic-authors/stoic:v1.0.0

# Initial lab name shown in the UI before the operator runs the
# onboarding wizard. The wizard overrides this at first launch.
LAB_NAME=Mio Laboratorio

# Default UI locale. Either "it" or "en". Users can change theirs
# individually from the account menu.
DEFAULT_LOCALE=it

# Backup encryption passphrase. When set, the nightly automatic
# backup is encrypted with AES-256-GCM. Lose it = backups are
# unreadable forever; treat it like a wallet seed phrase.
#
# Leave blank to disable backup encryption. You can also configure
# the passphrase source from Stoic's UI (Settings → Backups) after
# the first login.
# STOIC_BACKUP_PASSPHRASE=
