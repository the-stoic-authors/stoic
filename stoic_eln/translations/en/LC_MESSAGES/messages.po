msgstr "Draw the molecule; Stoic searches PubChem using the generated SMILES."

# ── Product/byproduct inventory tracking flag ────────────────────
msgid "Salva in inventario"
msgstr "Save to inventory"

msgid "Se attivo, al completamento del run questo prodotto crea un lotto in inventario. Disattiva per gli scarti (es. sali di neutralizzazione)."
msgstr "If on, this product creates an inventory lot when the run completes. Turn off for waste (e.g. neutralisation salts)."

msgid "Crea un lotto in inventario"
msgstr "Creates an inventory lot"

msgid "Scarto — non va in inventario"
msgstr "Waste — not stocked"


# ── Step-component inventory consumption (v1.4.4) ────────────────
msgid "Lotto %(lot)s: mancavano %(qty)g %(unit)s per %(name)s. Quantità registrata comunque, lotto azzerato."
msgstr "Lot %(lot)s: %(qty)g %(unit)s short for %(name)s. Quantity recorded anyway, lot set to zero."
