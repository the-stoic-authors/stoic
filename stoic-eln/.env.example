# Stoic ELN — Environment configuration
# Copy this file to .env and edit values for your setup.

# ─── Required ──────────────────────────────────────────────────────────────────

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-real-secret-key-please

# ─── Database ──────────────────────────────────────────────────────────────────

# Default: SQLite file in the project root.
# In Week 2 we'll switch to SQLCipher with a passphrase.
DATABASE_URL=sqlite:///stoic_eln.db

# ─── Application ───────────────────────────────────────────────────────────────

# Lab name shown in the header and on printed documents
LAB_NAME=Mio Laboratorio

# Default UI language: it | en
DEFAULT_LOCALE=it

# Default UI theme: system | light | dark
DEFAULT_THEME=system

# ─── Logging ───────────────────────────────────────────────────────────────────

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── Flask development ─────────────────────────────────────────────────────────

# debug | production | testing
FLASK_ENV=debug

# Enables auto-reload on code change. Disable in production.
FLASK_DEBUG=1
